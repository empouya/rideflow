generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Credential {
  userId       String   @id @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  provider     String   @default("LOCAL")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("credentials")
}